                "action": "bypass",
                "outbound": "Direct-Out"
            },
            {
                "type": "logical",
                "mode": "and",
                "rules": [
                    { "port": 443 },
                    { "network": "udp" },
                    { "rule_set": "cnsite", "invert": true },
                    { "rule_set": "cnip", "invert": true }
