{
    "http_clients": [
        {
            "tag": "proxy-client",
            "detour": "Default"
        }
    ],
    "experimental": {
        "clash_api": {
            "external_controller": "0.0.0.0:9090",
            "external_ui": "ui",
            "secret": "",
            "external_ui_download_url": "https://github.com/MetaCubeX/Yacd-meta/archive/gh-pages.zip",
            "external_ui_download_detour": "Default",
            "default_mode": "rule"
        },
        "cache_file": {
            "enabled": true,
            "store_dns": false
        }
    },
    "log": {
        "level": "info",
        "timestamp": true
    },
    "dns": {
        "servers": [
            {
                "tag": "proxy_dns",
                "type": "https",
                "server": "8.8.8.8",
                "detour": "Default"
            },
            {
                "tag": "cn_dns",
                "type": "udp",
                "server": "119.29.29.29"
            }
        ],
        "rules": [
            {
                "clash_mode": "direct",
                "server": "cn_dns"
            },
            {
                "clash_mode": "global",
                "server": "proxy_dns"
            },
            {
                "query_type": "AAAA",
                "action": "predefined",
                "rcode": "NOERROR"
            },
            {
                "rule_set": "gfw",
                "action": "route",
                "server": "proxy_dns"
            },
            {
                "domain_suffix": [ "googleapis.cn" ],
                "server": "proxy_dns"
            },
            {
                "type": "logical",
                "mode": "or",
                "action": "route",
                "rules": [
                    {
                        "domain_suffix": [ "ileidian.com" ]
                    },
                    {
                        "rule_set": "cnsite"
                    }
                ],
                "server": "cn_dns"
            },
            {
                "action": "route",
                "server": "proxy_dns"
            }
        ]
    },
    "inbounds": [
        {
            "type": "tun",
            "tag": "tun-in",
            "interface_name": "singbox_tun",
            "address": [ "172.18.0.1/30" ],
            "mtu": 1500,
            "auto_route": true,
            "route_exclude_address": [ "10.0.0.0/8", "100.64.0.0/10", "169.254.0.0/16", "172.16.0.0/12", "192.0.0.0/24", "192.168.0.0/16" ],
            "strict_route": true,
            "stack": "mixed",
            "dns_mode": "hijack",
            "platform": {
                "http_proxy": {
                    "enabled": true,
                    "server": "127.0.0.1",
                    "server_port": 7890,
                    "bypass_domain": [ ],
                    "match_domain": [ ]
                }
            }
        },
        {
            "type": "mixed",
            "tag": "mixed-in",
            "listen": "127.0.0.1",
            "listen_port": 7890
        }
    ],
    "outbounds": [
        {
            "type": "selector",
            "tag": "Default",
            "outbounds": [ "Auto", "Direct-Out" ]
        },
        {
            "type": "urltest",
            "tag": "Auto",
            "outbounds": [ ],
            "interval": "3m",
            "tolerance": 30
        },
        {
            "type": "selector",
            "tag": "Relay",
            "outbounds": [ "Direct-Out" ]
        },
        {
            "type": "selector",
            "tag": "PayPal",
            "outbounds": [ "Default", "Auto" ]
        },
        {
            "type": "selector",
            "tag": "AI-Service",
            "outbounds": [ "Default", "Auto" ]
        },
        {
            "type": "selector",
            "tag": "TikTok",
            "outbounds": [ "Default", "Auto" ]
        },
        {
            "type": "selector",
            "tag": "Streaming-Media",
            "outbounds": [ "Default", "Auto" ]
        },
        {
            "type": "selector",
            "tag": "Telegram",
            "outbounds": [ "Default", "Auto" ]
        },
        {
            "type": "selector",
            "tag": "Instagram",
            "outbounds": [ "Default", "Auto" ]
        },
        {
            "type": "selector",
            "tag": "Emby",
            "outbounds": [ "Default", "Auto", "Direct-Out" ]
        },
        {
            "type": "direct",
            "tag": "Direct-Out"
        }
    ],
    "route": {
        "final": "Default",
        "auto_detect_interface": true,
        "default_http_client": "proxy-client",
        "default_domain_resolver": { "server": "cn_dns" },
        "rule_set": [
            {
                "tag": "cnsite",
                "type": "remote",
                "format": "binary",
